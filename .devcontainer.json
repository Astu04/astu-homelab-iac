{
    "name": "astu-homelab-iac",
    // 1. Base OS
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    // 2. Features: The Magic Installers (No apt-get required!)
    "features": {
        // Gives you a fully isolated Docker daemon inside your dev container
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": true
        },
        // Installs Python (needed for Ansible)
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.11"
        },
        // Installs Terraform
        "ghcr.io/devcontainers/features/terraform:1": {
            "version": "latest"
        }
    },
    // 3. Environment Variables inside the container
    "containerEnv": {
        "EDITOR": "nano",
        "ANSIBLE_HOST_KEY_CHECKING": "False"
    },
    // 4. VS Code Customizations (Enforce extensions & settings)
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true
            },
            "extensions": [
                "redhat.ansible",
                "ms-azuretools.vscode-docker",
                "hashicorp.terraform",
                "tamasfe.even-better-toml",
                "mhutchie.git-graph"
            ]
        }
    },
    // 5. Commands to run AFTER the container is built
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y sshpass && pip3 install ansible"
}
