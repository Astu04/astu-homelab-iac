{
  "name": "astu-homelab-iac",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // 1. Dev Container Features
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "version": "latest",
      "moby": true
    }
  },
  // 2. Environment Variables
  "containerEnv": {
    "EDITOR": "nano"
  },
  // 3. VS Code Customizations & Extensions
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      },
      "extensions": [
        "redhat.ansible",
        "ms-azuretools.vscode-docker",
        "opentofu.opentofu",
        "tamasfe.even-better-toml",
        "mhutchie.git-graph",
        "bridgecrew.checkov"
      ]
    }
  },
  // 4. Lifecycle Hook: Arm Git hooks & initialize linters
  "postCreateCommand": "pre-commit install || true && tflint --init"
}